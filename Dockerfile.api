FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml ./
COPY uv.lock ./
COPY apps/api ./apps/api
RUN pip install --no-cache-dir uv==0.11.7 \
    && uv sync --frozen --no-dev --no-editable \
    && useradd --create-home --uid 10001 expense

USER expense
EXPOSE 8000
CMD ["sh", "-c", "exec /app/.venv/bin/uvicorn expense_intelligence.main:app --app-dir apps/api --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips ${FORWARDED_ALLOW_IPS:-127.0.0.1}"]
