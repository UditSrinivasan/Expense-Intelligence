APP_ENV=local
DATABASE_URL=sqlite:///./expense-intelligence.db
# Copy these values to the ignored .env.postgres file for Docker PostgreSQL.
POSTGRES_DB=expense_intelligence
POSTGRES_USER=expense
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
ALLOW_DEV_AUTH=true
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
WEB_ORIGIN=http://localhost:3000
# Server-only comma-separated Google email allowlist. Required when APP_ENV=hosted.
INVITED_USER_EMAILS=
RATE_LIMIT_ENABLED=true
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_RECYCLE_SECONDS=300
# API_URL is server-only and required for the hosted Next.js gateway.
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
FORWARDED_ALLOW_IPS=127.0.0.1
NEXT_PUBLIC_DEV_USER_ID=00000000-0000-4000-8000-000000000001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Disabled by default. Synthetic mode is the only model-connected data mode.
AGENT_MODE=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
AGENT_PROVIDER=gemini
AGENT_TEMPERATURE=0
AGENT_MAX_OUTPUT_TOKENS=300
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_RETRIES=0
AGENT_MAX_STEPS=8
AGENT_HISTORY_MESSAGES=12
